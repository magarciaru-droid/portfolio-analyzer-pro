# PORTFOLIO ANALYZER - Calcula métricas financieras
# ============================================================================

import pandas as pd
import numpy as np
from datetime import datetime

class PortfolioAnalyzer:
    """
    Calcula métricas y análisis de una cartera de inversiones
    
    Métricas calculadas:
    - Valor total y ganancia/pérdida
    - Sharpe Ratio (riesgo vs retorno)
    - Drawdown máximo (caída máxima histórica)
    - Volatilidad
    - Concentración (diversificación)
    """
    
    def __init__(self, df_cartera, tasa_libre_riesgo=0.025):
        """
        Args:
            df_cartera (pd.DataFrame): DataFrame con activos y precios
            tasa_libre_riesgo (float): Tasa libre de riesgo para Sharpe (defecto 2.5%)
        """
        self.df = df_cartera.copy()
        self.tasa_libre_riesgo = tasa_libre_riesgo
    
    def calcular_resumen(self):
        """
        Calcula resumen completo de métricas de la cartera
        
        Returns:
            dict: Diccionario con todas las métricas
        """
        return {
            'valor_actual': self.calcular_valor_total(),
            'inversion_total': self.calcular_inversion_total(),
            'ganancia_perdida': self.calcular_ganancia_total(),
            'retorno_porcentaje': self.calcular_retorno_porcentaje(),
            'sharpe_ratio': self.calcular_sharpe_ratio(),
            'volatilidad': self.calcular_volatilidad_cartera(),
            'drawdown_maximo': self.calcular_drawdown_maximo(),
            'concentracion': self.calcular_concentracion(),
            'num_activos': len(self.df),
            'distribucion_por_tipo': self.distribucion_por_tipo(),
            'top_ganancias': self.top_activos_ganancia(5),
            'top_perdidas': self.top_activos_perdida(5)
        }
    
    def calcular_valor_total(self):
        """
        Calcula el valor total actual de la cartera
        
        Returns:
            float: Valor actual en euros
        """
        return self.df['Valor_Actual'].sum()
    
    def calcular_inversion_total(self):
        """
        Calcula la inversión total realizada
        
        Returns:
            float: Suma de inversiones iniciales
        """
        return (self.df['Cantidad'] * self.df['Precio_Compra']).sum()
    
    def calcular_ganancia_total(self):
        """
        Calcula ganancia/pérdida total
        
        Returns:
            float: Ganancia o pérdida en euros
        """
        return self.df['Ganancia_Perdida'].sum()
    
    def calcular_retorno_porcentaje(self):
        """
        Calcula retorno porcentual total
        
        Returns:
            float: Porcentaje de retorno
        """
        inversion = self.calcular_inversion_total()
        if inversion == 0:
            return 0
        
        ganancia = self.calcular_ganancia_total()
        return (ganancia / inversion) * 100
    
    def calcular_volatilidad_cartera(self):
        """
        Calcula volatilidad media ponderada de la cartera
        
        Returns:
            float: Volatilidad en porcentaje
        """
        valor_total = self.calcular_valor_total()
        
        if valor_total == 0:
            return 0
        
        # Pesos de cada activo
        pesos = self.df['Valor_Actual'] / valor_total
        
        # Volatilidad ponderada
        volatilidad_media = (self.df['Volatilidad_%'].fillna(0) * pesos).sum()
        
        return volatilidad_media
    
    def calcular_sharpe_ratio(self):
        """
        Calcula Sharpe Ratio
        
        Fórmula: (Retorno Medio - Tasa Libre de Riesgo) / Volatilidad
        
        Interpretación:
        - > 1.0: Excelente (muy buen riesgo/retorno)
        - 0.5-1.0: Bueno
        - < 0.5: Podría optimizarse
        
        Returns:
            float: Sharpe Ratio
        """
        retorno = self.calcular_retorno_porcentaje() / 100
        volatilidad = self.calcular_volatilidad_cartera() / 100
        
        if volatilidad == 0:
            return 0
        
        sharpe = (retorno - self.tasa_libre_riesgo) / volatilidad
        return sharpe
    
    def calcular_drawdown_maximo(self):
        """
        Calcula el drawdown máximo (caída máxima desde el pico)
        
        Returns:
            float: Drawdown máximo en porcentaje
        """
        # Calcular valor acumulado en el tiempo (simplificado)
        # En una implementación real, usarías datos históricos diarios
        
        valor_actual = self.calcular_valor_total()
        inversion_total = self.calcular_inversion_total()
        
        # Drawdown aproximado
        if inversion_total > valor_actual:
            drawdown = ((inversion_total - valor_actual) / inversion_total) * 100
        else:
            drawdown = 0
        
        return min(drawdown, 100)  # Máximo 100%
    
    def calcular_concentracion(self):
        """
        Calcula índice de concentración (Herfindahl-Hirschman)
        
        Mide qué tan diversificada está la cartera
        - > 40%: Muy concentrada
        - 20-40%: Moderadamente concentrada
        - < 20%: Bien diversificada
        
        Returns:
            float: Índice de concentración 0-100
        """
        valor_total = self.calcular_valor_total()
        
        if valor_total == 0:
            return 0
        
        # Calcular peso de cada activo
        pesos = (self.df['Valor_Actual'] / valor_total) * 100
        
        # Índice HHI: suma de pesos al cuadrado
        hhi = (pesos ** 2).sum() / 100
        
        return hhi
    
    def distribucion_por_tipo(self):
        """
        Calcula distribución de la cartera por tipo de activo
        
        Returns:
            pd.Series: Porcentaje por tipo
        """
        valor_por_tipo = self.df.groupby('Tipo_Activo')['Valor_Actual'].sum()
        distribucion = (valor_por_tipo / valor_por_tipo.sum()) * 100
        
        return distribucion.round(2)
    
    def top_activos_ganancia(self, n=5):
        """
        Retorna los N activos con más ganancia
        
        Args:
            n (int): Número de activos a retornar
        
        Returns:
            pd.DataFrame: Top N activos por ganancia
        """
        return self.df.nlargest(n, 'Ganancia_Perdida')[
            ['Ticker', 'Ganancia_Perdida', 'Retorno_%']
        ]
    
    def top_activos_perdida(self, n=5):
        """
        Retorna los N activos con más pérdida
        
        Args:
            n (int): Número de activos a retornar
        
        Returns:
            pd.DataFrame: Top N activos por pérdida
        """
        return self.df.nsmallest(n, 'Ganancia_Perdida')[
            ['Ticker', 'Ganancia_Perdida', 'Retorno_%']
        ]
    
    def analizar_diversificacion(self):
        """
        Análisis detallado de diversificación
        
        Returns:
            dict: Análisis de diversificación
        """
        distribucion = self.distribucion_por_tipo()
        concentracion = self.calcular_concentracion()
        
        analisis = {
            'distribucion_por_tipo': distribucion.to_dict(),
            'concentracion': concentracion,
            'num_activos': len(self.df),
            'activo_principal': self.df.loc[self.df['Valor_Actual'].idxmax(), 'Ticker'] if len(self.df) > 0 else None,
            'peso_activo_principal': (self.df['Valor_Actual'].max() / self.calcular_valor_total() * 100) if self.calcular_valor_total() > 0 else 0
        }
        
        return analisis
    
    def calcular_correlacion(self):
        """
        Calcula matriz de correlación entre activos
        
        Returns:
            pd.DataFrame: Matriz de correlación
        """
        # Esta función es más avanzada y requeriría datos históricos
        # Por ahora retornamos un DataFrame vacío
        return pd.DataFrame()
    
    def recomendaciones_rebalanceo(self):
        """
        Sugiere rebalanceo si algún activo está muy concentrado
        
        Returns:
            list: Recomendaciones
        """
        recomendaciones = []
        valor_total = self.calcular_valor_total()
        
        for idx, row in self.df.iterrows():
            peso = (row['Valor_Actual'] / valor_total) * 100
            
            if peso > 40:
                recomendaciones.append(
                    f"⚠️ {row['Ticker']} representa {peso:.1f}% - Considera reducir"
                )
            elif peso < 2 and len(self.df) > 5:
                recomendaciones.append(
                    f"📌 {row['Ticker']} es muy pequeño ({peso:.2f}%) - Considera eliminar o aumentar"
                )
        
        if not recomendaciones:
            recomendaciones.append("✅ La cartera está bien balanceada")
        
        return recomendaciones
