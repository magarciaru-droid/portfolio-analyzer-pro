import pandas as pd
import gspread
from google.colab import auth  # Solo en Colab
from oauth2client.client import GoogleCredentials
import streamlit as st
import os

from config import GOOGLE_SHEETS_ID, HOJA_ACTIVOS, HOJA_RENDIMIENTO

def conectar_google_sheets():
    """
    Conecta con Google Sheets usando Streamlit Secrets
    
    En Streamlit Cloud, las credenciales se guardan en .streamlit/secrets.toml
    """
    try:
        # Opción 1: Usar Streamlit Secrets (recomendado para producción)
        if "GOOGLE_SHEETS_CREDENTIALS" in st.secrets:
            credentials_dict = st.secrets["GOOGLE_SHEETS_CREDENTIALS"]
            gc = gspread.service_account_from_dict(credentials_dict)
        else:
            # Opción 2: Usar archivo local (para desarrollo)
            gc = gspread.service_account(filename="credentials.json")
        
        return gc
    except Exception as e:
        raise Exception(f"Error de autenticación: {str(e)}")

def cargar_datos_google_sheets():
    """
    Carga datos de Google Sheets y retorna DataFrame con activos
    
    Returns:
        pd.DataFrame: DataFrame con columnas:
        - ID_Cartera
        - Ticker
        - Cantidad
        - Precio_Compra
        - Tipo_Activo
        - Fecha_Compra
    """
    try:
        # Conectar con Google Sheets
        gc = conectar_google_sheets()
        
        # Abrir el documento
        sh = gc.open_by_key(GOOGLE_SHEETS_ID)
        
        # Cargar hoja de activos
        worksheet = sh.worksheet(HOJA_ACTIVOS)
        data = worksheet.get_all_records()
        
        # Convertir a DataFrame
        df = pd.DataFrame(data)
        
        # Limpiar columnas (eliminar espacios)
        df.columns = df.columns.str.strip()
        
        # Convertir tipos de datos
        df['Cantidad'] = pd.to_numeric(df['Cantidad'], errors='coerce')
        df['Precio_Compra'] = pd.to_numeric(df['Precio_Compra'], errors='coerce')
        
        # Validar
        if df.empty:
            raise ValueError("No hay datos en la hoja de activos")
        
        return df
    
    except Exception as e:
        raise Exception(f"Error al cargar Google Sheets: {str(e)}")

def cargar_rendimiento_cuentas():
    """
    Carga datos de rendimiento de cuentas remuneradas
    
    Returns:
        pd.DataFrame: DataFrame con:
        - ID_Cartera
        - Nombre_Cuenta
        - Saldo_Inicial
        - Rendimiento_Fijo_%
    """
    try:
        gc = conectar_google_sheets()
        sh = gc.open_by_key(GOOGLE_SHEETS_ID)
        worksheet = sh.worksheet(HOJA_RENDIMIENTO)
        data = worksheet.get_all_records()
        
        df = pd.DataFrame(data)
        df.columns = df.columns.str.strip()
        
        df['Saldo_Inicial'] = pd.to_numeric(df['Saldo_Inicial'], errors='coerce')
        df['Rendimiento_Fijo_%'] = pd.to_numeric(df['Rendimiento_Fijo_%'], errors='coerce')
        
        return df
    
    except Exception as e:
        print(f"Nota: No se pudo cargar rendimiento de cuentas: {str(e)}")
        return pd.DataFrame()  # Retornar vacío si falla

# Caché para optimizar carga
@st.cache_data(ttl=300)  # Cache por 5 minutos
def cargar_datos_cached():
    """Versión cacheada de cargar_datos_google_sheets"""
    return cargar_datos_google_sheets()
